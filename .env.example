# Credentials
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# OAuth2
AUTH_URL=https://api.uhg.com/oauth2/token
SCOPE=https://your-auth-scope/.default
GRANT_TYPE=client_credentials

# Azure OpenAI
AZURE_ENDPOINT=https://your-azure-endpoint/
API_VERSION=2025-01-01-preview
PROJECT_ID=your-project-id-here

# Deployments
CHAT_DEPLOYMENT=your-chat-deployment-name
CHAT_MODEL=gpt-4o-mini
EMBED_DEPLOYMENT=your-embed-deployment-name
EMBED_MODEL=text-embedding-ada-002

# ChromaDB (optional, defaults to "docs")
CHROMA_COLLECTION_NAME=docs

# MLflow (optional — defaults to ./mlruns inside the project folder)
# MLFLOW_TRACKING_URI=http://your-mlflow-server:5000
